
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core User model with authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String    // Required for credentials auth
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // App-specific fields
  plan          String    @default("free")
  settingsJson  Json?     // User preferences, saved presets
  lastLoginAt   DateTime?
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  scanPresets   ScanPreset[]
  scanRuns      ScanRun[]
  strategies    UserStrategy[]
  savedReports  SavedReport[]
  tradeJournal  TradeJournal[]
  
  @@index([email])
}

// NextAuth adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
}

// App-specific models
model ScanPreset {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  config      Json     // Scanner configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanRuns ScanRun[]
  
  @@index([userId])
}

model ScanRun {
  id           String   @id @default(cuid())
  userId       String
  presetId     String?
  status       String   // pending, running, completed, failed
  results      Json?    // Array of setup cards
  resultsCount Int      @default(0)
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  errorMessage String?
  
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset ScanPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([presetId])
  @@index([status])
}

// Hybrid Historical Outcome Model
// Tracks real trade outcomes with multi-horizon and first-touch data
model StrategyBacktest {
  id           String   @id @default(cuid())
  symbol       String
  timeframe    String   @default("1D")
  strategy     String
  signalDate   DateTime
  
  // Entry details
  entry        Float
  stop         Float
  direction    String   // long, short
  
  // Targets
  target1      Float
  target2      Float
  target3      Float?
  
  // Quality metrics at signal time
  quality      Float
  viability    Float
  rrFirst      Float
  
  // Multi-horizon outcomes (5d/10d/20d)
  outcome5d    String?  // hit_t1, hit_t2, hit_t3, stopped_out, still_open
  outcome10d   String?
  outcome20d   String?
  
  // Path-based first-touch outcome
  firstTouch   String?  // T1, T2, T3, stop
  daysHeld     Int?     // Days until first touch
  
  // Multi-horizon P&L percentages
  pnl5d        Float?
  pnl10d       Float?
  pnl20d       Float?
  
  // Market context
  spyRegime    String
  volZ         Float
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([symbol, timeframe])
  @@index([strategy])
  @@index([signalDate])
  @@index([symbol, strategy, signalDate])
}

// Aggregate statistics cache with multi-horizon data
model StrategyStats {
  id            String   @id @default(cuid())
  symbol        String
  timeframe     String   @default("1D")
  strategy      String
  
  // Sample count and minimum enforcement
  sampleCount   Int      @default(0)
  hasMinSamples Boolean  @default(false) // true if >= 10 samples
  
  // Multi-horizon win rates
  winRate5d     Float    @default(0)
  winRate10d    Float    @default(0)
  winRate20d    Float    @default(0)
  
  // Multi-horizon average P&L
  avgPnL5d      Float    @default(0)
  avgPnL10d     Float    @default(0)
  avgPnL20d     Float    @default(0)
  
  // First-touch distribution
  firstTouchT1  Int      @default(0)
  firstTouchT2  Int      @default(0)
  firstTouchT3  Int      @default(0)
  firstTouchStop Int     @default(0)
  avgDaysHeld   Float    @default(0)
  
  // Quality flags
  isWeakHistory Boolean  @default(false) // winRate10d < 0.20 OR avgPnL10d < 0
  
  lastUpdated   DateTime @updatedAt
  
  @@unique([symbol, timeframe, strategy])
  @@index([symbol])
  @@index([strategy])
  @@index([hasMinSamples])
}

// User-defined custom strategies
model UserStrategy {
  id          String   @id @default(cuid())
  userId      String
  name        String   @db.VarChar(100)
  description String?  @db.Text
  
  // Strategy DSL JSON (validated with Zod)
  dsl         Json
  
  // Quick-access fields (denormalized for queries)
  direction   String   @db.VarChar(10)  // long, short
  timeframe   String   @db.VarChar(10)  // 1min, 5min, 15min, 1hour, 1day
  
  // Status and usage
  isActive    Boolean  @default(true)
  priority    Int      @default(0)      // Higher = evaluated first
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsedAt  DateTime?
  useCount    Int      @default(0)
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  backtests   UserStrategyBacktest[]
  
  @@index([userId])
  @@index([userId, isActive])
  @@index([priority])
  @@unique([userId, name])
}

// Backtest results for user-defined strategies
model UserStrategyBacktest {
  id             String   @id @default(cuid())
  strategyId     String
  symbol         String
  timeframe      String   @default("1D")
  signalDate     DateTime
  
  // Entry details
  entry          Float
  stop           Float
  direction      String   // long, short
  
  // Targets
  target1        Float
  target2        Float?
  target3        Float?
  
  // Quality metrics
  quality        Float
  viability      Float
  rrFirst        Float
  
  // Multi-horizon outcomes
  outcome5d      String?
  outcome10d     String?
  outcome20d     String?
  
  // First-touch outcome
  firstTouch     String?  // T1, T2, T3, stop
  daysHeld       Int?
  
  // Multi-horizon P&L
  pnl5d          Float?
  pnl10d         Float?
  pnl20d         Float?
  
  // Market context
  spyRegime      String
  volZ           Float
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  strategy       UserStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  
  @@index([strategyId])
  @@index([symbol, timeframe])
  @@index([signalDate])
  @@index([strategyId, symbol, signalDate])
}

// Saved Analysis Reports
// Stores complete analysis reports with optimization for reruns
model SavedReport {
  id          String   @id @default(cuid())
  userId      String
  
  // Report metadata
  type        String   // "deep-analysis", "strategy-analysis", "backtest"
  title       String   @db.VarChar(200)
  description String?  @db.Text
  
  // Input parameters (for rerun)
  parameters  Json     // { symbol, timeframe, strategyId, config, etc. }
  
  // Full report data
  reportData  Json     // Complete analysis results, metrics, charts
  
  // Cached data for optimization
  cachedData  Json?    // Historical bars, indicators, fundamentals (static data)
  
  // Metadata
  version     String   @default("1.0")  // Schema version for migrations
  tags        String[] // User tags for organization
  isPinned    Boolean  @default(false)  // Pin to top of list
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastViewedAt DateTime?
  lastRerunAt  DateTime?
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeJournalEntries TradeJournal[] // Trades linked to this analysis report
  
  @@index([userId])
  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([userId, isPinned])
}

// Trading Journal with AI Analysis
// Tracks real trades with auto-calculated metrics and market data enrichment
model TradeJournal {
  id          String   @id @default(cuid())
  userId      String
  
  // User-provided fields (required)
  ticker      String   @db.VarChar(10)
  direction   String   @db.VarChar(10)  // "long" or "short"
  entryPrice  Float
  entryDate   DateTime
  exitPrice   Float?   // Null if trade is still open
  exitDate    DateTime?
  amount      Float    // Dollar amount in the trade
  
  // User-provided fields (optional)
  strategy    String?  @db.VarChar(100)  // Strategy name or "Other"
  notes       String?  @db.Text          // Free-text notes for AI analysis
  isOpen      Boolean  @default(false)   // Is trade still open?
  exitReason  String?  @db.VarChar(20)   // hit_target, stopped_out, manual_exit, time_exit
  
  // Auto-calculated fields
  returnPct   Float?   // Return percentage
  rMultiple   Float?   // R multiple (if stop available)
  holdingDays Int?     // Holding period in days
  profitLoss  Float?   // P/L in dollars
  maxPotentialR Float? // Maximum R multiple achieved post-entry (for early exit detection)
  
  // Linked analysis report (auto-populated if analysis exists within ±3 days)
  analysisReportId String? // Links to SavedReport for strategy feedback loop
  
  // Enriched market data (populated on save)
  entryOHLC   Json?    // {open, high, low, close, volume} for entry date
  exitOHLC    Json?    // {open, high, low, close, volume} for exit date
  entryEMA9   Float?   // EMA 9 on entry date
  entryEMA20  Float?   // EMA 20 on entry date
  entryEMA50  Float?   // EMA 50 on entry date
  entryRSI    Float?   // RSI on entry date
  entryATR    Float?   // ATR on entry date
  exitEMA9    Float?   // EMA 9 on exit date
  exitEMA20   Float?   // EMA 20 on exit date
  exitEMA50   Float?   // EMA 50 on exit date
  exitRSI     Float?   // RSI on exit date
  exitATR     Float?   // ATR on exit date
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisReport SavedReport? @relation(fields: [analysisReportId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([userId, createdAt])
  @@index([ticker])
  @@index([strategy])
  @@index([direction])
  @@index([isOpen])
  @@index([analysisReportId])
  @@index([exitReason])
}