
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core User model with authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String    // Required for credentials auth
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // App-specific fields
  plan          String    @default("free")
  settingsJson  Json?     // User preferences, saved presets
  lastLoginAt   DateTime?
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  scanPresets   ScanPreset[]
  scanRuns      ScanRun[]
  savedReports  SavedReport[]
  tradeJournal  TradeJournal[]
  journalAnalyses JournalAnalysis[]
  strategies    Strategy[]
  webullConnection WebullConnection?
  
  @@index([email])
}

// NextAuth adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
}

// App-specific models
model ScanPreset {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  config      Json     // Scanner configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanRuns ScanRun[]
  
  @@index([userId])
}

model ScanRun {
  id           String   @id @default(cuid())
  userId       String
  presetId     String?
  status       String   // pending, running, completed, failed
  results      Json?    // Array of setup cards
  resultsCount Int      @default(0)
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  errorMessage String?
  
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset ScanPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([presetId])
  @@index([status])
}

// Saved Analysis Reports
// Stores complete analysis reports with optimization for reruns
model SavedReport {
  id          String   @id @default(cuid())
  userId      String
  
  // Report metadata
  type        String   // "deep-analysis", "strategy-analysis", "backtest"
  title       String   @db.VarChar(200)
  description String?  @db.Text
  
  // Input parameters (for rerun)
  parameters  Json     // { symbol, timeframe, strategyId, config, etc. }
  
  // Full report data
  reportData  Json     // Complete analysis results, metrics, charts
  
  // Cached data for optimization
  cachedData  Json?    // Historical bars, indicators, fundamentals (static data)
  
  // Metadata
  version     String   @default("1.0")  // Schema version for migrations
  tags        String[] // User tags for organization
  isPinned    Boolean  @default(false)  // Pin to top of list
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastViewedAt DateTime?
  lastRerunAt  DateTime?
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeJournalEntries TradeJournal[] // Trades linked to this analysis report
  
  @@index([userId])
  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([userId, isPinned])
}

// Trading Journal with AI Analysis
// Tracks real trades with auto-calculated metrics and market data enrichment
model TradeJournal {
  id          String   @id @default(cuid())
  userId      String
  
  // User-provided fields (required)
  ticker      String   @db.VarChar(10)
  direction   String   @db.VarChar(10)  // "long" or "short"
  tradeType   String   @default("swing") @db.VarChar(10) // "swing" or "intraday"
  entryPrice  Float
  entryDate   DateTime
  exitPrice   Float?   // Null if trade is still open
  exitDate    DateTime?
  amount      Float    // Dollar amount in the trade
  
  // Time-of-day for intraday precision (HH:MM:SS format, e.g. "09:32:15")
  entryTime   String?  @db.VarChar(12)
  exitTime    String?  @db.VarChar(12)
  
  // Import source tracking
  source          String  @default("manual") @db.VarChar(20)  // "manual" | "webull"
  externalOrderId String? @db.VarChar(100) // Webull order ID for deduplication

  // User-provided fields (optional)
  strategy    String?  @db.VarChar(100)  // Strategy name or "Other"
  strategyId  String?                     // FK to Strategy model
  notes       String?  @db.Text          // Free-text notes for AI analysis
  isOpen      Boolean  @default(false)   // Is trade still open?
  exitReason  String?  @db.VarChar(20)   // hit_target, stopped_out, manual_exit, time_exit
  
  // Auto-calculated fields
  returnPct   Float?   // Return percentage
  rMultiple   Float?   // R multiple (if stop available)
  holdingDays Int?     // Holding period in days
  profitLoss  Float?   // P/L in dollars
  maxPotentialR Float? // Maximum R multiple achieved post-entry (for early exit detection)
  
  // Webull-specific enrichment
  filledQty       Float?   // Actual filled quantity from broker
  avgFillPrice    Float?   // Average fill price from broker
  orderType       String?  @db.VarChar(30)  // MARKET, LIMIT, STOP_LOSS, etc.
  instrumentType  String?  @db.VarChar(20)  // EQUITY, OPTION, CRYPTO
  
  // Linked analysis report (auto-populated if analysis exists within ±3 days)
  analysisReportId String? // Links to SavedReport for strategy feedback loop
  
  // Ticker snapshot data (populated via Finnhub/Polygon on save or enrichment)
  sector          String?  @db.VarChar(100)
  industry        String?  @db.VarChar(100)
  marketCap       Float?            // in millions
  floatShares     Float?            // in millions
  sharesOutstanding Float?          // in millions
  shortPercent    Float?            // short interest as % of float
  avgVolume       Float?            // average daily volume
  beta            Float?

  // Enriched market data (populated on save)
  entryOHLC   Json?    // {open, high, low, close, volume} for entry date
  exitOHLC    Json?    // {open, high, low, close, volume} for exit date
  entryEMA9   Float?   // EMA 9 on entry date
  entryEMA20  Float?   // EMA 20 on entry date
  entryEMA50  Float?   // EMA 50 on entry date
  entryRSI    Float?   // RSI on entry date
  entryATR    Float?   // ATR on entry date
  exitEMA9    Float?   // EMA 9 on exit date
  exitEMA20   Float?   // EMA 20 on exit date
  exitEMA50   Float?   // EMA 50 on exit date
  exitRSI     Float?   // RSI on exit date
  exitATR     Float?   // ATR on exit date
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisReport SavedReport? @relation(fields: [analysisReportId], references: [id], onDelete: SetNull)
  strategyRef    Strategy?    @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  
  @@unique([userId, externalOrderId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([ticker])
  @@index([strategy])
  @@index([strategyId])
  @@index([direction])
  @@index([isOpen])
  @@index([source])
  @@index([analysisReportId])
  @@index([exitReason])
}

// Reusable trading strategies with descriptions and criteria
model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String   @db.VarChar(100)
  description String?  @db.Text
  criteria    Json?    // { entry_rules: [], exit_rules: [], indicators: [], timeframes: [] }
  tradeType   String   @default("intraday") @db.VarChar(10) // "intraday" | "swing" | "both"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades TradeJournal[]

  @@unique([userId, name])
  @@index([userId])
}

// Webull API connection credentials and token state
model WebullConnection {
  id              String   @id @default(cuid())
  userId          String   @unique
  accountId       String?  @db.VarChar(50)
  accessToken     String?  @db.Text
  tokenStatus     String?  @db.VarChar(20) // PENDING, NORMAL, INVALID, EXPIRED
  tokenExpiresAt  DateTime?
  host            String   @default("api.webull.com") @db.VarChar(100)
  lastSyncAt      DateTime?
  lastSyncCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalAnalysis {
  id              String   @id @default(cuid())
  userId          String
  periodLabel     String   @db.VarChar(100)
  typeFilter      String?  @db.VarChar(10)  // "all" | "intraday" | "swing" - filters used when generated
  tradesAnalyzed  Int
  intradayCount   Int      @default(0)
  swingCount      Int      @default(0)
  winRate         Float?
  totalPL         Float?
  analysis        String   @db.Text
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, typeFilter])
}