
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core User model with authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String    // Required for credentials auth
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // App-specific fields
  plan          String    @default("free")
  settingsJson  Json?     // User preferences, saved presets
  lastLoginAt   DateTime?
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  scanPresets   ScanPreset[]
  scanRuns      ScanRun[]
  
  @@index([email])
}

// NextAuth adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
}

// App-specific models
model ScanPreset {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  config      Json     // Scanner configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanRuns ScanRun[]
  
  @@index([userId])
}

model ScanRun {
  id           String   @id @default(cuid())
  userId       String
  presetId     String?
  status       String   // pending, running, completed, failed
  results      Json?    // Array of setup cards
  resultsCount Int      @default(0)
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  errorMessage String?
  
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset ScanPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([presetId])
  @@index([status])
}

// Hybrid Historical Outcome Model
// Tracks real trade outcomes with multi-horizon and first-touch data
model StrategyBacktest {
  id           String   @id @default(cuid())
  symbol       String
  timeframe    String   @default("1D")
  strategy     String
  signalDate   DateTime
  
  // Entry details
  entry        Float
  stop         Float
  direction    String   // long, short
  
  // Targets
  target1      Float
  target2      Float
  target3      Float?
  
  // Quality metrics at signal time
  quality      Float
  viability    Float
  rrFirst      Float
  
  // Multi-horizon outcomes (5d/10d/20d)
  outcome5d    String?  // hit_t1, hit_t2, hit_t3, stopped_out, still_open
  outcome10d   String?
  outcome20d   String?
  
  // Path-based first-touch outcome
  firstTouch   String?  // T1, T2, T3, stop
  daysHeld     Int?     // Days until first touch
  
  // Multi-horizon P&L percentages
  pnl5d        Float?
  pnl10d       Float?
  pnl20d       Float?
  
  // Market context
  spyRegime    String
  volZ         Float
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([symbol, timeframe])
  @@index([strategy])
  @@index([signalDate])
  @@index([symbol, strategy, signalDate])
}

// Aggregate statistics cache with multi-horizon data
model StrategyStats {
  id            String   @id @default(cuid())
  symbol        String
  timeframe     String   @default("1D")
  strategy      String
  
  // Sample count and minimum enforcement
  sampleCount   Int      @default(0)
  hasMinSamples Boolean  @default(false) // true if >= 10 samples
  
  // Multi-horizon win rates
  winRate5d     Float    @default(0)
  winRate10d    Float    @default(0)
  winRate20d    Float    @default(0)
  
  // Multi-horizon average P&L
  avgPnL5d      Float    @default(0)
  avgPnL10d     Float    @default(0)
  avgPnL20d     Float    @default(0)
  
  // First-touch distribution
  firstTouchT1  Int      @default(0)
  firstTouchT2  Int      @default(0)
  firstTouchT3  Int      @default(0)
  firstTouchStop Int     @default(0)
  avgDaysHeld   Float    @default(0)
  
  // Quality flags
  isWeakHistory Boolean  @default(false) // winRate10d < 0.20 OR avgPnL10d < 0
  
  lastUpdated   DateTime @updatedAt
  
  @@unique([symbol, timeframe, strategy])
  @@index([symbol])
  @@index([strategy])
  @@index([hasMinSamples])
}